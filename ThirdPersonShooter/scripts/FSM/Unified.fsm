                    "blendTime": 0.15
                },
                {
                    "from": "JumpStart",
                    "to": "RifleCrouchLocomotion",
                    "condition": "weaponType == 1 and isCrouching",
                    "priority": 15,
                    "blendTime": 0.15
                },
                {
                    "from": "JumpAir",
