                    "to": "Locomotion",
                    "condition": "isGrounded and not isCrouching",
                    "blendTime": 0.2
                },
                {
                    "from": "JumpStart",
                    "to": "CrouchLocomotion",
                    "condition": "isGrounded and isCrouching",
                    "blendTime": 0.2
                },
                {
                    "from": "Locomotion",
                    "to": "JumpAir",
                    "condition": "not isGrounded and weaponType == 0",
