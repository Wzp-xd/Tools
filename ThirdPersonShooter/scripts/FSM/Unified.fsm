                    "blendTime": 0.2
                },
                {
                    "from": "CrouchLocomotion",
                    "to": "JumpAir",
                    "condition": "not isGrounded and weaponType == 0",
                    "priority": 5,
                    "blendTime": 0.2
                },
                {
                    "from": "JumpAir",
