                    "blendTime": 0.2
                },
                {
                    "from": "JumpAir",
                    "to": "CrouchLocomotion",
                    "condition": "isGrounded and isCrouching",
                    "priority": 1,
                    "blendTime": 0.2
                },
                {
                    "from": "JumpLanding",
                    "to": "Locomotion",
                    "condition": "(animationFinished or moveSpeed > 0.5) and not isCrouching",
                    "blendTime": 0.2
                },
                {
                    "from": "JumpLanding",
                    "to": "CrouchLocomotion",
                    "condition": "(animationFinished or moveSpeed > 0.5) and isCrouching",
                    "blendTime": 0.2
                },
                {
                    "from": "JumpStart",
                    "to": "RifleLocomotion",
                    "condition": "weaponType == 1 and not isCrouching",
